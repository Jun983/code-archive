@startuml fall-through
!theme plain
skinparam DefaultFontSize 13
skinparam ActivityBackgroundColor #E8EDF8
skinparam ActivityBorderColor #5C78C8
skinparam ArrowColor #333333
skinparam DiamondBackgroundColor #E8EDF8
skinparam DiamondBorderColor #5C78C8

start
switch (day?)
case (1, 2, 3, 4, 5)
  :평일 출력;
case (6, 7)
  :주말 출력;
endswitch
stop
@enduml
